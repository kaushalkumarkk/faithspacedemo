# Copy to .env (git-ignored) and fill in.

# --- Database ---------------------------------------------------------------
# Supabase PostgreSQL (session pooler). URL-encode special characters in the password:
#   @ -> %40    ! -> %21    # -> %23    / -> %2F
DATABASE_URL=postgresql://postgres.zwyxbxlxzvfkdidbdafe:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Zero-setup local alternative (SQLite):
# DATABASE_URL=sqlite:///./faithspace.db
# Local Postgres via docker compose:
# DATABASE_URL=postgresql://faithspace:faithspace@localhost:5432/faithspace

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_MINUTES=1440

# --- Web --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Media (local disk; storage keys are exposed, never paths) ---------------
STORAGE_DIR=./storage
MAX_VIDEO_MB=100
MAX_AUDIO_MB=60
MAX_IMAGE_MB=5

# --- Rate limits (per minute) -------------------------------------------------
LOGIN_RATE_LIMIT=10
UPLOAD_RATE_LIMIT=30
